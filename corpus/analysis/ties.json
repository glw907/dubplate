    {
      "case_id": "should-ask",
      "album_id": "4b3d18cc-8937-36f4-8de0-481088be58e6",
      "optimal_cost": 1.7962962962962963,
      "best_forbidden_cost": 1.7962962962962963,
      "difference": 0,
      "unique": false,
      "disposition": "pinned",
      "reason": "Items 1 and 6 are the case's two deliberately corrupted items, and their distances to tracks 1 and 6 are equal, so assigning 1-\u003e6, 6-\u003e1 and assigning 1-\u003e1, 6-\u003e6 cost the same. The album is not a VA release, so beets recomputes the final per-track distances under the same incl_artist=False objective the assignment used: both optima produce the same album distance and the same medium recommendation, and only the mapping itself is arbitrary. The mapping lapjv chose is the expectation; a Go solver has to mirror its tie-breaking to match this row."
    },
    {
      "case_id": "should-reject",
      "album_id": "d073287b-d1bd-4f11-a933-a4386f8cf701",
      "optimal_cost": 5.282407407407407,
      "best_forbidden_cost": 5.282407407407407,
      "difference": 0,
      "unique": false,
      "disposition": "pinned",
      "reason": "Same shape as should-ask, six corrupted items wide: forbidding any of the pairs (1,1), (3,3), (7,9), (9,5) or (11,11) re-solves to the same cost through a permutation of the corrupted items alone. The album is not a VA release, so every tied optimum scores the same album distance and the same none recommendation. The mapping lapjv chose is the expectation; a Go solver has to mirror its tie-breaking to match this row."
    },
