#!/usr/bin/env bash
set -euo pipefail
# musicbox-ping-failure <slug>: the OnFailure= target for music-import.service
# and music-backup.service (see systemd/music-import.service,
# systemd/music-backup.service and the musicbox-ping-failure@.service
# template). systemd invokes this with the failed unit's healthchecks.io
# slug as its one argument; ping_hc does the rest, including the no-op
# fallback when the matching MUSICBOX_HC_<SLUG>_URL var is unset.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./lib.sh
source "$SCRIPT_DIR/lib.sh"

if [ "$#" -ne 1 ]; then
  echo "usage: musicbox-ping-failure <healthchecks-slug>" >&2
  exit 1
fi

ping_hc "$1" fail
