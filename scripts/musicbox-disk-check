#!/usr/bin/env bash
set -euo pipefail
# musicbox-disk-check: pings MUSICBOX_HC_DISK_URL based on how full the
# filesystem holding /srv/music is. Nothing else in musicbox watches this
# proactively: music-import's own free_space_ok guard only fires while an
# import is actually running, so a slow fill between runs (backups, a
# growing review queue, an untended quarantine dir) would otherwise go
# unnoticed until the next import's abort. This check exists to catch that
# gap directly, on its own schedule.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./lib.sh
source "$SCRIPT_DIR/lib.sh"

MUSICBOX_ROOT="${MUSICBOX_ROOT:-/srv/music}"
THRESHOLD_PCT="${MUSICBOX_DISK_THRESHOLD_PCT:-90}"

# Same shape as music-backup's: every abort here is the same three steps,
# and a later guard added with the fail ping left off would leave a full
# disk looking healthy on the dashboard.
abort_with_fail_ping() {
  echo "musicbox-disk-check: $1" >&2
  ping_hc disk fail
  exit 1
}

# df -Pk (same flags as lib.sh's free_space_ok) has a stable column count
# and a "Capacity" column ending in a literal "%" (e.g. "90%"); gsub strips
# it so the comparison below is a plain integer test. Run first and
# checked explicitly, rather than inlined into the variable assignment:
# under `set -e`, a failed command substitution used as an assignment's
# RHS still aborts the script immediately, which would exit without ever
# reaching the abort_with_fail_ping call below -- a missing/unmounted
# MUSICBOX_ROOT must report failure, not vanish silently.
if ! df_line="$(df -Pk "$MUSICBOX_ROOT" 2>&1)"; then
  abort_with_fail_ping "df failed for $MUSICBOX_ROOT: $df_line"
fi
usage_pct="$(awk 'NR==2 { gsub(/%/, "", $5); print $5 }' <<<"$df_line")"

if [ -z "$usage_pct" ]; then
  abort_with_fail_ping "could not parse df output for $MUSICBOX_ROOT: $df_line"
fi

if [ "$usage_pct" -gt "$THRESHOLD_PCT" ]; then
  abort_with_fail_ping "$MUSICBOX_ROOT is ${usage_pct}% full, over the ${THRESHOLD_PCT}% threshold."
fi

ping_hc disk
echo "musicbox-disk-check: $MUSICBOX_ROOT is ${usage_pct}% full (threshold ${THRESHOLD_PCT}%); OK."
