#!/usr/bin/env bash
set -euo pipefail
# music-import: the hosted gatekeeper. Runs under flock so a scheduled
# invocation never overlaps another run or an interactive `beet` session
# (see music-beet). Scans each contributor's inbox, stages quiescent
# uploads, imports them with beets, files anything beets could not
# confidently tag for manual review, and nudges Navidrome to rescan.
#
# Every path and credential is overridable via env var so the same script
# runs unmodified against the real /srv/music tree and against a fixture
# tree in tests; only the defaults are production values.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./lib.sh
source "$SCRIPT_DIR/lib.sh"

MUSICBOX_ROOT="${MUSICBOX_ROOT:-/srv/music}"
INBOX_DIR="$MUSICBOX_ROOT/inbox"
STAGING_DIR="$MUSICBOX_ROOT/staging"
REVIEW_DIR="$MUSICBOX_ROOT/review"
# Where a quality-gate failure lands when it cannot be filed to review at
# all. Deliberately outside both staging and review's own tree, so a
# problem isolated to review (its permissions, a bad mount) doesn't also
# block the fallback: a different failure domain, reached by a different
# filesystem path. Not created up front like the directories below, since
# a healthy box never has one.
QUARANTINE_FAILED_DIR="$MUSICBOX_ROOT/quarantine-failed"
STATE_DIR="$MUSICBOX_ROOT/state"
# Shared with music-beet via lib.sh's musicbox_lock_file, so the two never
# drift onto different lock files (see that function's comment for why the
# default is a persistent path rather than the RuntimeDirectory tmpfs).
LOCK_FILE="$(musicbox_lock_file)"
# Where trigger_navidrome_scan puts its short-lived curl --config file
# (carries the Navidrome admin credentials, briefly) and where
# load_contributors_json caches its JSON parse. Deliberately NOT derived
# from the lock file's directory: those two are short-lived, run-scoped
# artifacts that have no business surviving past this run, so they stay on
# systemd's RuntimeDirectory=musicbox (tmpfs, wiped at every unit stop and
# every boot) even though the lock file itself moved to the persistent
# /var/lib/musicbox. Overridable via MUSICBOX_RUNTIME_DIR for the fixture
# tree in tests.
RUNTIME_DIR="${MUSICBOX_RUNTIME_DIR:-/run/musicbox}"
QUIESCENT_MINUTES="${MUSICBOX_QUIESCENT_MINUTES:-10}"
MIN_FREE_GB="${MUSICBOX_MIN_FREE_GB:-5}"
MAX_ARCHIVE_BYTES="${MUSICBOX_MAX_ARCHIVE_BYTES:-2147483648}"
REVIEW_RETENTION_DAYS="${MUSICBOX_REVIEW_RETENTION_DAYS:-60}"
CONTRIBUTORS_FILE="${MUSICBOX_CONTRIBUTORS_FILE:-/etc/musicbox/contributors.yaml}"
GEOFF_EMAIL="${MUSICBOX_GEOFF_EMAIL:-geoff-login@907.life}"
NAVIDROME_URL="${NAVIDROME_URL:-http://localhost:4533}"
# config/ is rsynced wholesale to $REMOTE_DIR/config by deploy.sh (no
# dedicated deploy step of its own, unlike contributors.yaml: this file
# carries no secrets or PII, just copy-editable customer-facing text).
REJECT_EMAIL_TEMPLATE="${MUSICBOX_REJECT_EMAIL_TEMPLATE:-/opt/musicbox/config/reject-email.txt}"
# Where load_contributors_json caches contributors.yaml's JSON parse for
# the rest of this run. Suffixed with this process's own PID, not a fixed
# name: a hard-killed previous run that skipped the trap below would
# otherwise leave a stale cache file for a fresh run to mistake for its own
# parse. RUNTIME_DIR is already relied on to exist here -- systemd's
# RuntimeDirectory=musicbox creates it fresh every boot.
CONTRIBUTORS_JSON_CACHE="$RUNTIME_DIR/contributors-parsed.$$.json"
trap 'rm -f "$CONTRIBUTORS_JSON_CACHE"' EXIT

# A held lock means another run (or an interactive music-beet session) is
# already touching the beets database; skip quietly rather than queue up.
# Pinged as a success, not skipped or failed: a wedged lock either means a
# real concurrent run (the common, healthy case this check exists for) or
# a stuck previous run (rare; its own timeout is a separate concern), and
# healthchecks.io has no "this run did nothing, and that's fine" state
# between success and failure. Spec decision, 2026-08-30: treat it as
# success rather than let a merely-overlapping run page Geoff at 3am; the
# accepted residual is a wedged import silently reporting healthy until
# someone notices stale music in the library.
#
# musicbox_ensure_lock_dir runs first because nothing else creates the
# persistent lock directory, and `exec` under `set -e` aborts the whole run
# on a missing one; that function's own comment carries the rest.
musicbox_ensure_lock_dir "$LOCK_FILE"
exec 200>"$LOCK_FILE"
if ! flock -n 200; then
  echo "music-import: another run holds the lock; exiting." >&2
  ping_hc import
  exit 0
fi

mkdir -p "$STAGING_DIR" "$REVIEW_DIR" "$STATE_DIR"

# Checked here, before a single archive is extracted or a single file is
# staged, not after: staging can itself consume the last of the free space
# it is meant to guard, and an archive already expanded onto disk by the
# time this check runs would have to be un-staged rather than simply never
# staged. Nothing above this line touches contributor data -- only the
# musicbox tree's own scaffold directories.
if ! free_space_ok "$MUSICBOX_ROOT" "$MIN_FREE_GB"; then
  echo "music-import: free space on $MUSICBOX_ROOT is below ${MIN_FREE_GB}GB; aborting before import." >&2
  ping_hc import fail
  exit 1
fi

DATE_STR="$(date +%Y-%m-%d)"
LOGFILE="$STATE_DIR/import-$(date +%Y%m%d-%H%M%S).log"

# True for filenames beets can't read directly: Bandcamp delivers ZIPs, and
# without unpacking them the archive would just sit in staging forever.
is_archive_name() {
  case "${1,,}" in
  *.zip | *.tar | *.tar.gz | *.tgz | *.tar.bz2 | *.tbz2) return 0 ;;
  *) return 1 ;;
  esac
}

# Prints contributors.yaml's JSON parse, computing it only on the first
# call this run and reading the on-disk cache (CONTRIBUTORS_JSON_CACHE)
# thereafter -- empty output for a missing CONTRIBUTORS_FILE, matching
# uploader_email/uploader_name's prior behavior of treating "no file" the
# same as "no match". A run can call the two of them once per skipped or
# quarantined album, so without this the same static file would cost a
# fresh yq|jq pipeline every single time.
#
# The cache lives in a file rather than a shell variable because every
# caller here is invoked inside a `$(...)` command substitution, which
# forks a subshell: a variable set on first load never survives past that
# subshell's exit, so the very next command substitution would see the
# unloaded state all over again. The cache file's own existence is the
# "already loaded" flag (an empty file still counts, for the missing-file
# case), which a subshell's writes to disk do outlive.
#
# Created 0600 before any content is written, in both branches: RUNTIME_DIR
# (systemd's RuntimeDirectory=musicbox) is world-traversable at 0755 with no
# UMask= override, and contributors.yaml itself is deployed 0640 root:music
# specifically so its contributor names and emails aren't world-readable
# (deploy.sh) -- a 0644 cache under the default umask would undo that for
# the run's duration. trigger_navidrome_scan's own config_file below is
# private the same way.
load_contributors_json() {
  if [ ! -e "$CONTRIBUTORS_JSON_CACHE" ]; then
    : >"$CONTRIBUTORS_JSON_CACHE"
    chmod 0600 "$CONTRIBUTORS_JSON_CACHE"
    if [ -f "$CONTRIBUTORS_FILE" ]; then
      yq -o=json "$CONTRIBUTORS_FILE" >"$CONTRIBUTORS_JSON_CACHE"
    fi
  fi
  cat "$CONTRIBUTORS_JSON_CACHE"
}

# Looks up a contributor's email by matching the inbox directory name
# against contributors.yaml's "name" field (the only identifier the
# uploaded tree carries). Empty output means no match; callers treat that
# as "can't notify this uploader", not as an error.
uploader_email() {
  local user="$1" json
  json="$(load_contributors_json)"
  [ -n "$json" ] || return 0
  jq -r --arg n "$user" '.contributors[]? | select(.name == $n) | .email' <<<"$json" |
    head -n1
}

# The first word of a contributor's name, for the quality-gate rejection
# email's greeting ("Hi Alice,"); empty output means the inbox directory
# matches no contributor, which callers treat the same way uploader_email's
# empty output is treated. contributors.yaml is matched on its "name" field
# against that same inbox directory name, so a matched contributor's name
# IS the directory name: the query below confirms membership rather than
# fetching some other string, and the first word is all the greeting wants
# of a full display name like "Example Family Member".
uploader_name() {
  local user="$1" json
  json="$(load_contributors_json)"
  [ -n "$json" ] || return 0
  jq -e --arg n "$user" 'any(.contributors[]?; .name == $n)' <<<"$json" >/dev/null || return 0
  printf '%s' "${user%% *}"
}

# Moves one contributor's quiescent inbox entries into their staging
# subdirectory. Each archive is first expanded into its own private,
# per-archive scratch subdirectory (via mktemp -d, never straight into
# dest) and only then has its top-level entries individually moved into
# dest under a collision-safe name (unique_dest_path). Extracting straight
# into the shared dest would let two archives in the same batch step on
# each other: two rips both landing a top-level "Album" directory, or two
# loose tracks both named "01.flac", would silently merge or clobber
# instead of both surviving. Routing every archive through its own scratch
# dir first, then reconciling names on the move into dest, keeps that
# collision from ever reaching the shared tree. Archives are removed from
# the inbox once staged (successfully or not: safe_extract leaves the
# entry alone on rejection) so a later run never re-extracts them;
# everything else is moved as-is.
stage_user_uploads() {
  local user="$1" src="$2" dest="$3" entry name extract_dir item item_name target
  mkdir -p "$dest"
  shopt -s nullglob
  for entry in "$src"/*; do
    name="$(basename "$entry")"
    if [ -f "$entry" ] && is_archive_name "$name"; then
      extract_dir="$(mktemp -d "$dest/.extract-XXXXXX")"
      if safe_extract "$entry" "$extract_dir" "$MAX_ARCHIVE_BYTES"; then
        while IFS= read -r -d '' item; do
          item_name="$(basename "$item")"
          target="$(unique_dest_path "$dest" "$item_name")"
          mv "$item" "$target"
        done < <(find "$extract_dir" -mindepth 1 -maxdepth 1 -print0)
        rm -f "$entry"
      else
        echo "music-import: rejected archive $entry; left in $user's inbox for review" >&2
      fi
      rm -rf "$extract_dir"
    else
      mv "$entry" "$dest/"
    fi
  done
  shopt -u nullglob
}

# Parses beets' quiet-import logfile (lines "skip <path>[; <path>...]",
# per beets' own tag_log format), relocates each skipped path to
# review/<date>/<uploader>/, and notifies the uploader plus Geoff once
# each, never once per skipped file.
move_skips_and_notify() {
  local logfile="$1" review_root="$2" date_str="$3"
  local -A skip_users=()
  [ -f "$logfile" ] || return 0

  local line rest part trimmed rel user dest_dir
  while IFS= read -r line; do
    case "$line" in
    "skip "*)
      rest="${line#skip }"
      IFS=';' read -ra parts <<<"$rest"
      for part in "${parts[@]}"; do
        trimmed="${part# }"
        [ -n "$trimmed" ] && [ -e "$trimmed" ] || continue
        rel="${trimmed#"$STAGING_DIR"/}"
        user="${rel%%/*}"
        dest_dir="$review_root/$date_str/$user"
        safe_mv_to_review "$trimmed" "$dest_dir" >/dev/null || continue
        skip_users["$user"]=1
      done
      ;;
    esac
  done <"$logfile"

  [ "${#skip_users[@]}" -eq 0 ] && return 0

  local email
  for user in "${!skip_users[@]}"; do
    email="$(uploader_email "$user")"
    if [ -n "$email" ]; then
      notify "$email" "Musicbox: some uploads need review" \
        "Some of your uploaded music could not be auto-tagged and was moved to $review_root/$date_str/$user for Geoff to review."
    else
      echo "music-import: no email on file for uploader '$user'; skipping their notice" >&2
    fi
  done
  notify "$GEOFF_EMAIL" "Musicbox: import skipped items ($date_str)" \
    "Contributors with skipped uploads today: ${!skip_users[*]}. See $review_root/$date_str."
}

# Translates one of quality_gate's raw, technical reasons into the plain
# language the rejection-email template needs. quality_gate's own wording
# is for Geoff's copy (a path and a reason are all he needs); an uploader
# needs to know what to do about it, never a decode-test name.
friendly_reason() {
  local file="$1" raw="$2" ext
  case "$raw" in
  "not FLAC"*)
    ext="${file##*.}"
    case "${ext,,}" in
    mp3) ext="MP3" ;;
    m4a) ext="AAC" ;;
    ogg) ext="Ogg Vorbis" ;;
    opus) ext="Opus" ;;
    wav) ext="WAV" ;;
    aiff) ext="AIFF" ;;
    *) ext="${ext^^}" ;;
    esac
    echo "This is an $ext file, and the library keeps lossless FLAC."
    ;;
  *"decode test failed"*)
    echo "This file didn't survive the upload intact. Uploading it again usually fixes this."
    ;;
  *"below CD quality"*)
    echo "This FLAC is below CD quality."
    ;;
  "symlink not allowed"*)
    echo "This looks like a symlink or shortcut rather than a real file, and the library only accepts real files."
    ;;
  *)
    echo "$raw"
    ;;
  esac
}

# Fills config/reject-email.txt's three placeholders -- {first name},
# {album or file name}, and {one reason line per file, from the mapping
# below} -- with plain bash substring replacement (the template has no
# other braces, so a literal match is enough; no sed metacharacter risk).
# Geoff owns the copy in that file; this function never rewords it.
#
# Every replacement value is quoted. Unquoted, bash 5.2+ treats a literal
# "&" in a ${var//pattern/replacement} replacement as "insert the matched
# text" -- exactly like sed -- so an unquoted $name of "Sturm & Drang"
# would render as "Sturm {album or file name} Drang" instead of the album's
# own name. Confirmed against this box's bash (5.3.9).
render_reject_email() {
  local first_name="$1" name="$2" reason_lines="$3" template
  [ -f "$REJECT_EMAIL_TEMPLATE" ] || return 1
  template="$(<"$REJECT_EMAIL_TEMPLATE")"
  template="${template//\{first name\}/"$first_name"}"
  template="${template//\{album or file name\}/"$name"}"
  template="${template//\{one reason line per file, from the mapping below\}/"$reason_lines"}"
  printf '%s' "$template"
}

# Runs quality_gate over the whole staging tree, between extraction and
# beet import. beets only ever sees what's still in staging afterward, so
# any audio file that fails takes its whole containing album directory (or,
# for a bare singleton, just the file) to review/<date>/<user>/: admitting
# the passing tracks from an otherwise-failing rip would tag a partial
# album into the library while the rest vanishes into review with no
# context to reassemble it from. Sends one friendly, plain-language email
# per quarantined album to its uploader (config/reject-email.txt) and one
# technical summary to Geoff, covering every album this run quarantined.
quarantine_quality_failures() {
  local staging_root="$1" review_root="$2" date_str="$3"
  local file reason rel rest user album_key
  # Keyed by "<user>/<album>", the same relative pair Geoff's summary
  # prints and the only thing the second loop needs: both the uploader and
  # the album directory read straight back out of the key, so no second
  # array has to be kept in step with this one.
  local -A album_reasons=() # "user/album" -> "relpath<TAB>raw reason\n..." lines
  local -a album_order=()   # first-seen order, for deterministic emails

  while IFS=$'\t' read -r file reason; do
    [ -n "$file" ] || continue
    rel="${file#"$staging_root"/}" # <user>/<album>/<track> (or <user>/<track>)
    user="${rel%%/*}"
    rest="${rel#*/}"
    album_key="$user/${rest%%/*}"
    [ -n "${album_reasons[$album_key]+x}" ] || album_order+=("$album_key")
    album_reasons["$album_key"]+="$rel"$'\t'"$reason"$'\n'
  done < <(quality_gate "$staging_root")

  [ "${#album_order[@]}" -eq 0 ] && return 0

  local album_dir dest holding_dest first_name email failed_rel raw_reason
  local friendly_lines geoff_summary=""
  for album_key in "${album_order[@]}"; do
    user="${album_key%%/*}"
    album_dir="$staging_root/$album_key"
    dest="$review_root/$date_str/$user"
    holding_dest="$QUARANTINE_FAILED_DIR/$date_str/$user"
    if ! safe_mv_to_review "$album_dir" "$dest" >/dev/null; then
      # safe_mv_to_review has already warned about the move itself. beet
      # import scans $STAGING_DIR recursively with no way to skip one
      # subdirectory, so this album must still leave staging by some
      # path, or it gets silently imported despite failing the quality
      # gate -- the guarantee this whole function exists for. Geoff hears
      # about it either way: a quarantine that could not be filed the
      # normal way must never go silent just because that way failed.
      if safe_mv_to_review "$album_dir" "$holding_dest" >/dev/null; then
        geoff_summary+="$album_key: could not move; excluded from import (see $holding_dest)"$'\n'
      else
        geoff_summary+="$album_key: COULD NOT MOVE BY ANY MEANS -- still in staging and beet import may ingest it; manual removal required"$'\n'
      fi
      continue
    fi

    # Each line carries its own file's basename, so N failures in one
    # album read as N distinct per-file lines rather than one paragraph.
    friendly_lines=""
    while IFS=$'\t' read -r failed_rel raw_reason; do
      [ -n "$failed_rel" ] || continue
      friendly_lines+="${failed_rel##*/}: $(friendly_reason "$failed_rel" "$raw_reason")"$'\n'
    done <<<"${album_reasons[$album_key]}"
    # Drop the trailing newline: the template already supplies the blank
    # line that separates the reasons block from the next paragraph, and
    # keeping this one would double it.
    friendly_lines="${friendly_lines%$'\n'}"

    email="$(uploader_email "$user")"
    first_name="$(uploader_name "$user")"
    if [ -z "$email" ]; then
      echo "music-import: no email on file for uploader '$user'; skipping their quality-gate notice" >&2
    elif [ -z "$first_name" ]; then
      echo "music-import: no contributor name on file for uploader '$user'; skipping their quality-gate notice" >&2
    elif [ ! -f "$REJECT_EMAIL_TEMPLATE" ]; then
      # Checked here, not left to render_reject_email's own guard: notify
      # takes the rendered body as a command substitution, whose failed
      # exit status nothing downstream inspects, so the uploader would
      # get an empty-bodied email. Geoff's summary below still lands.
      echo "music-import: reject-email template $REJECT_EMAIL_TEMPLATE is missing; skipping the quality-gate notice for '$user'" >&2
    else
      notify "$email" "Your music upload needs a different format" \
        "$(render_reject_email "$first_name" "${album_key#*/}" "$friendly_lines")"
    fi

    geoff_summary+="$album_key:"$'\n'"${album_reasons[$album_key]}"
  done

  # Belt and suspenders alongside the album_order check above: every
  # branch of the loop appends something, so this cannot be empty today.
  # A no-content email is worse than a skipped one if that ever changes.
  [ -n "$geoff_summary" ] || return 0

  notify "$GEOFF_EMAIL" "Musicbox: import quality gate failures ($date_str)" \
    "The following uploads failed the quality gate today (see each item for where it landed):

$geoff_summary"
}

# Best-effort: a failed scan trigger does not fail the import, because
# Navidrome's daily Scanner.Schedule backstop will pick up the change
# regardless. Pinned Navidrome 0.63.2 has no native admin scan endpoint
# (confirmed against upstream source: StartScan is registered only as the
# Subsonic API's admin-only startScan action), so this calls
# GET /rest/startScan with Subsonic's query-param auth: t is
# md5(password+salt), s is a fresh random salt per call, and u/v/c carry
# the username, API version, and client name the spec requires, plus f for
# the response format.
#
# That query string is a credential, so the full URL is written to a curl
# --config file (mode 0600, under RUNTIME_DIR, which the lock file
# deliberately no longer shares) instead of ever appearing as a curl
# argument: an argument lands in argv,
# which every local user can read from /proc or `ps`, but a --config
# file's contents do not. Only non-secret flags (-fsS, -o /dev/null) stay
# on the command line.
#
# The never-fails contract covers every step here, not just the final
# curl: jq/od/md5sum could be missing, mktemp or chmod or the config-file
# write could fail (a full /run/musicbox, a permissions problem), and any
# of those under the caller's `set -e` would abort the whole import run
# over a monitoring side effect. Bash disables errexit inside a compound
# command that is the left operand of `||` (and an inner `set -e` cannot
# re-enable it), so `( set -e; ... ) || …` would let execution run past a
# failing step to the next one instead of stopping there. Stopping at the
# first failing step is what the `set +e` toggle below buys: the subshell
# it wraps belongs to no `||` or `if` condition, so the subshell's own
# `set -euo pipefail` takes effect, and its status is captured explicitly
# rather than swallowed by a guard.
trigger_navidrome_scan() {
  if [ -z "${NAVIDROME_ADMIN_USER:-}" ] || [ -z "${NAVIDROME_ADMIN_PASSWORD:-}" ]; then
    echo "music-import: NAVIDROME_ADMIN_USER/NAVIDROME_ADMIN_PASSWORD not set; skipping scan trigger." >&2
    return 0
  fi
  set +e
  (
    set -euo pipefail
    local user_enc salt token scan_url config_file
    # The username is the only value here that can carry characters
    # needing escaping -- both for the query string and for the quoted
    # config-file value below, which would otherwise read a bare " or \
    # as syntax. The token and salt are hex.
    user_enc="$(jq -rn --arg s "$NAVIDROME_ADMIN_USER" '$s | @uri')"
    # od reads exactly 8 bytes and stops, unlike the usual
    # `tr </dev/urandom | head` idiom, whose early-closing head would send
    # tr a SIGPIPE that pipefail could propagate out of this substitution.
    salt="$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')"
    token="$(printf '%s' "${NAVIDROME_ADMIN_PASSWORD}${salt}" | md5sum | cut -d' ' -f1)"
    scan_url="$NAVIDROME_URL/rest/startScan?u=$user_enc&t=$token&s=$salt&v=1.16.1&c=musicbox&f=json"

    config_file="$(mktemp "$RUNTIME_DIR/navidrome-scan.XXXXXX")"
    # Registered right after the file exists, before anything is written
    # to it, so it cannot outlive this subshell by any path out of it --
    # a later step failing included.
    trap 'rm -f "$config_file"' EXIT
    chmod 0600 "$config_file"
    printf 'url = "%s"\n' "$scan_url" >"$config_file"

    curl -fsS -o /dev/null --config "$config_file"
  )
  local rc=$?
  set -e
  [ "$rc" -eq 0 ] || echo "music-import: Navidrome scan request failed." >&2
  return 0
}

# Removes each top-level dated subdirectory of dir older than
# REVIEW_RETENTION_DAYS, so a contributor's bad MusicBrainz match (or a
# quality-gate quarantine) doesn't sit there forever if never swept; 60
# days gives Geoff a season to drain the queue by hand. Applied to both
# REVIEW_DIR and QUARANTINE_FAILED_DIR -- the latter is deliberately never
# created up front (a healthy box never has one), so this is a no-op until
# the fallback-quarantine path in quarantine_quality_failures first creates
# it.
sweep_old_dirs() {
  local dir="$1"
  [ -d "$dir" ] || return 0
  find "$dir" -mindepth 1 -maxdepth 1 -type d -mtime "+$REVIEW_RETENTION_DAYS" -exec rm -rf {} +
}

shopt -s nullglob
for user_dir in "$INBOX_DIR"/*/; do
  user="$(basename "$user_dir")"
  if ! quiescent "$user_dir" "$QUIESCENT_MINUTES"; then
    echo "music-import: $user's inbox is still changing; skipping this run." >&2
    continue
  fi
  if [ -z "$(find "$user_dir" -mindepth 1 -print -quit)" ]; then
    continue
  fi
  stage_user_uploads "$user" "$user_dir" "$STAGING_DIR/$user"
done
shopt -u nullglob

quarantine_quality_failures "$STAGING_DIR" "$REVIEW_DIR" "$DATE_STR"

beet import -q -l "$LOGFILE" "$STAGING_DIR"
move_skips_and_notify "$LOGFILE" "$REVIEW_DIR" "$DATE_STR"
find "$STAGING_DIR" -mindepth 1 -type d -empty -delete

trigger_navidrome_scan
sweep_old_dirs "$REVIEW_DIR"
sweep_old_dirs "$QUARANTINE_FAILED_DIR"
ping_hc import
