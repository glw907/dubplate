#!/usr/bin/env bash
set -euo pipefail
# musicbox-navidrome-check: HTTP heartbeat against Navidrome's own Subsonic
# /rest/ping endpoint, pinging MUSICBOX_HC_NAVIDROME_URL accordingly. This
# is deliberately a bare reachability check, not an authenticated one: the
# Subsonic protocol always answers HTTP 200 (auth failure is a "failed"
# status inside the response body, never a non-2xx), so curl -f's exit
# status already distinguishes "Navidrome's HTTP listener answered" from
# "it didn't" -- connection refused, timeout, or a 5xx from a container
# that's up but wedged -- without this script needing real credentials or
# any response-body parsing. Whether Subsonic auth itself is configured
# correctly is a separate concern from whether the process is alive.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./lib.sh
source "$SCRIPT_DIR/lib.sh"

# Matches music-import's own default: Navidrome binds loopback-only
# (compose.yaml), and this check runs on the same host.
NAVIDROME_URL="${NAVIDROME_URL:-http://localhost:4533}"

if curl -fsS --retry 3 --max-time 10 -o /dev/null "$NAVIDROME_URL/rest/ping"; then
  ping_hc navidrome
  echo "musicbox-navidrome-check: $NAVIDROME_URL/rest/ping reachable; OK."
else
  echo "musicbox-navidrome-check: $NAVIDROME_URL/rest/ping did not respond." >&2
  ping_hc navidrome fail
  exit 1
fi
