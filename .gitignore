# Nothing secret exists in this repo yet; these are defensive, not because
# either path is populated today.
*.env
env/rendered/

# The beets oracle's Python venv, built with uv per tools/venv/README.md.
# requirements.txt pins what belongs in it, so the tree itself is
# reproducible output, not source. __pycache__ is the shim's bytecode;
# corpus/.derive is where a derivation run puts scratch when it is
# pointed inside the repo instead of at the system temp dir.
/tools/venv/.venv/
__pycache__/
/corpus/.derive/

# corpus/staging/ is a case's working directory during the synth ->
# freeze -> iterate authoring loop (corpus/README.md, "Authoring a
# synthetic case"): a case promotes to corpus/cases/<id>/ only once its
# derivation records zero misses, so nothing under staging/ is ever a
# committed fixture.
/corpus/staging/

# Go build output (make build / make build-linux).
/dubplate-server
/dubplate-server-linux-amd64

# Web (_salvage/web/README.md documents the build). node_modules is
# workstation build-time only, never shipped; dist is Vite's build
# output, empty on a fresh checkout except placeholder.txt (kept below
# so `go build` stays green before anyone runs `npm run build`).
/_salvage/web/node_modules
/_salvage/web/dist/*
!/_salvage/web/dist/placeholder.txt

# web/: node_modules is workstation build-time only, .svelte-kit is
# kit's generated scratch directory, and build/ is adapter-static's
# output, cleared on every build. build's placeholder.txt is kept so a
# fresh checkout's //go:embed directive still compiles before anyone
# runs `npm run build`.
/web/node_modules/
/web/.svelte-kit/
/web/build/*
!/web/build/placeholder.txt

# Local brainstorm companion session state; never repo content.
/.superpowers/
