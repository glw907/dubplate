[Unit]
Description=dubplate: nightly backup of the beets and Navidrome databases to R2
# Rewrite plan T13 (single-generation closeout): replaces
# music-backup.service outright -- the shell layer is deleted in this same
# change.
#
# OnFailure targets the Go ping-fail chain (dubplate-ping-fail@backup.
# service, DUBPLATE_PING_BACKUP_URL), not the retired
# musicbox-ping-failure@ template. Belt and suspenders alongside
# internal/backup's own success/fail ping (same env var): this catches a
# crash before Run ever reaches its own ping call.
OnFailure=dubplate-ping-fail@backup.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=music
EnvironmentFile=/etc/dubplate/env
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# /var/lib/musicbox (DUBPLATE_STATE_DIR) holds this run's backup.lock
# (internal/backup's lockPath); /srv/music/state/backup-staging
# (DUBPLATE_BACKUP_STAGING) is where it stages the sqlite3 .backup
# snapshots before rclone syncs them to R2. LibraryDir and both source
# databases are read-only under this unit -- ProtectSystem=strict leaves
# the rest of the filesystem readable, just not writable -- so neither
# needs a ReadWritePaths entry. Both paths are pre-created by deploy.sh
# (music:music); ReadWritePaths requires the host path to already exist or
# the unit fails to start with "Failed to set up mount namespacing".
#
# The grant on backup-staging is deliberately leaf-only, not its parent
# /srv/music/state (which also holds Navidrome's live database and must
# stay read-only to this unit). That is why internal/backup clears
# backup-staging by removing its CONTENTS rather than the directory itself
# on every run: rmdir-ing the directory would rewrite its parent's
# entries, which sit outside this narrow grant, while each child lives
# inside the writable bind mount and can be removed freely.
ReadWritePaths=/var/lib/musicbox /srv/music/state/backup-staging
ExecStart=/usr/local/bin/dubplate backup
