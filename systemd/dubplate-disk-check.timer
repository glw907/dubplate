[Unit]
Description=dubplate: run dubplate-disk-check every 15 minutes

[Timer]
# Mirrors musicbox-disk-check.timer's own schedule and jitter exactly:
# same job, same rationale (spreads the check across a 5-minute window
# instead of firing on the exact minute boundary every time, so this timer
# and music-import.timer's *:0/15 schedule don't stack their disk I/O).
OnCalendar=*:0/15
RandomizedDelaySec=300
Persistent=true
Unit=dubplate-disk-check.service

[Install]
WantedBy=timers.target
