[Unit]
Description=musicbox: run musicbox-navidrome-check every 5 minutes

[Timer]
OnCalendar=*:0/5
# A shorter jitter window than the 15-minute disk check's, proportional to
# this timer's own 5-minute interval: enough to avoid firing on the exact
# minute boundary every time without eating a large fraction of the
# interval itself.
RandomizedDelaySec=60
Persistent=true
Unit=musicbox-navidrome-check.service

[Install]
WantedBy=timers.target
