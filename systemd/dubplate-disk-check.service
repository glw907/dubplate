[Unit]
Description=dubplate: check /srv/music's filesystem for low free space
# Rewrite plan T13 (single-generation closeout): replaces
# musicbox-disk-check.service outright -- the shell layer is deleted in this
# same change. OnFailure targets the Go ping-fail chain
# (dubplate-ping-fail@disk.service, DUBPLATE_PING_DISK_URL), not the retired
# musicbox-ping-failure@ template; belt and suspenders alongside
# internal/checks.DiskChecker's own fail ping (same env var), catching a
# crash before Run ever reaches its own ping call.
OnFailure=dubplate-ping-fail@disk.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=music
EnvironmentFile=/etc/dubplate/env
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# No ReadWritePaths: DiskChecker only statfs(2)s LibraryDir's filesystem
# and sends an HTTP ping, matching musicbox-disk-check.service's own
# no-writes shape.
ExecStart=/usr/local/bin/dubplate check disk
