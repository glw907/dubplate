[Unit]
Description=musicbox: run music-import every 15 minutes

[Timer]
OnCalendar=*:0/15
# Spreads the check across a 5-minute window instead of firing on the exact
# minute boundary every time, so this timer and musicbox-disk-check.timer's
# own *:0/15 schedule don't repeatedly stack their disk I/O in the same
# instant (mirrors that timer's own RandomizedDelaySec comment).
RandomizedDelaySec=300
Persistent=true
Unit=music-import.service

[Install]
WantedBy=timers.target
