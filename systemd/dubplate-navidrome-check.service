[Unit]
Description=dubplate: HTTP heartbeat against Navidrome's /rest/ping
# Rewrite plan T13 (single-generation closeout): replaces
# musicbox-navidrome-check.service outright -- the shell layer is deleted in
# this same change. OnFailure targets the Go ping-fail chain
# (dubplate-ping-fail@navidrome.service, DUBPLATE_PING_NAVIDROME_URL), not
# the retired musicbox-ping-failure@ template; belt and suspenders alongside
# internal/checks.NavidromeChecker's own fail ping (same env var), catching
# a crash before Run ever reaches its own ping call.
OnFailure=dubplate-ping-fail@navidrome.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=music
EnvironmentFile=/etc/dubplate/env
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# No ReadWritePaths: NavidromeChecker only issues an outbound HTTP GET and
# sends an HTTP ping, matching musicbox-navidrome-check.service's own
# no-writes shape.
ExecStart=/usr/local/bin/dubplate check navidrome
