[Unit]
Description=musicbox: nightly backup of the beets and Navidrome databases to R2
# See music-import.service's comment: the instance name is a healthchecks.io
# slug, matched against MUSICBOX_HC_BACKUP_URL in env/musicbox.env.template.
OnFailure=musicbox-ping-failure@backup.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=music
# Creates /run/musicbox every boot, owned by music:music (see
# music-import.service's comment: /run/lock is root:root 0755 on Alma, not
# Debian's 1777). No longer holds this unit's own overlap-guard lock file --
# that moved to the persistent /var/lib/musicbox, since RuntimeDirectory=
# musicbox is shared with music-import.service and systemd removes it
# (without reference counting) whenever either unit stops.
RuntimeDirectory=musicbox
EnvironmentFile=/etc/musicbox/env
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# /var/lib/musicbox holds this unit's persistent backup-lock file;
# deploy.sh pre-creates it (owned music:music), same as for
# music-import.service -- ReadWritePaths requires the path to already
# exist on the host or the unit fails to start.
ReadWritePaths=/srv/music /run/musicbox /var/lib/musicbox
ExecStart=/usr/local/bin/music-backup
