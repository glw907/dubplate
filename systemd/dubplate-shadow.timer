[Unit]
Description=dubplate: run dubplate-shadow every 5 minutes

[Timer]
# The five-minute interval matches the incumbent's own quiescence
# window (docs/superpowers/specs/2026-09-05-rung-4-shadow.md:462-469):
# the poll interval must sit strictly inside that window, or a pass can
# straddle a still-settling import and miss its capture.
#
# Persistent=true, deliberately not "at most a later capture": the
# incumbent sweeps its run reports to the newest thirty and fires
# *:0/15 itself, so the oracle signal for every album imported during
# an outage longer than roughly seven and a half hours is gone
# permanently (docs/superpowers/specs/2026-09-05-rung-4-shadow.md:1208-1216).
# A catch-up run after a reboot is exactly the pass that recovers what
# is still recoverable.
#
# A five-minute interval cannot overlap its own predecessor
# (HISTORY handoff item 4, docs/HISTORY.md:411-415): the wire cap is
# sixty tokens and the pace is 2 * musicbrainz.DefaultInterval, so
# sixty tokens at two seconds a token bounds one pass at two minutes,
# comfortably inside this timer's five-minute window.
OnCalendar=*:0/5
RandomizedDelaySec=60
Persistent=true
Unit=dubplate-shadow.service

[Install]
WantedBy=timers.target
