[Unit]
Description=musicbox: run music-backup daily at 11:30 UTC

[Timer]
OnCalendar=*-*-* 11:30:00 UTC
# A small fraction of the 24-hour interval: avoids R2 uploads landing on the
# same wall-clock second every day without meaningfully delaying the backup.
RandomizedDelaySec=600
Persistent=true
Unit=music-backup.service

[Install]
WantedBy=timers.target
