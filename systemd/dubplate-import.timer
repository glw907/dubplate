[Unit]
Description=dubplate: run dubplate-import every 15 minutes

[Timer]
# Mirrors music-import.timer's own schedule and jitter exactly: same job,
# same rationale (spreads the run across a 5-minute window instead of firing
# on the exact minute boundary every time, so this timer and
# dubplate-disk-check.timer's own *:0/15 schedule don't stack their disk
# I/O).
OnCalendar=*:0/15
RandomizedDelaySec=300
Persistent=true
Unit=dubplate-import.service

[Install]
WantedBy=timers.target
