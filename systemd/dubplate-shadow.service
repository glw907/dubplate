[Unit]
Description=dubplate: observe the incumbent importer's decisions against the Go matcher (oracle)
# Why the network-online pairing is taken: five sibling oneshots carry
# it (dubplate-import, dubplate-backup, dubplate-disk-check,
# dubplate-navidrome-check, dubplate-ping-fail@) and the serve unit's
# fifteen-line comment (dubplate-serve.service:12-26) explains why it
# does not. This unit's own reason: a *:0/5 timer otherwise fires
# before the network is up after a reboot and turns a boot into a
# failure ping. dubplate-disk-check.service:11-12 is the precedent for
# taking network-online without docker.service: the shadow reaches
# MusicBrainz and touches no container, so it has nothing to wait on
# but the network.
OnFailure=dubplate-ping-fail@shadow.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=music
EnvironmentFile=/etc/dubplate/server.env
ExecStart=/usr/local/bin/dubplate-server shadow observe

# Why the grant is one leaf path: TestStoreWritesNothingOutsideItsRoot
# (internal/engine/shadow/store_test.go) is the static argument that
# every write the store makes, and the attacker-shaped ".."-bearing id
# it refuses, stay confined to the OpenStore root passed in. deploy.sh
# pre-creates this exact path before the unit ever starts (Task 3's
# edit); without that pre-create, startup fails with "Failed to set up
# mount namespacing", systemd's own error for a ReadWritePaths= entry
# that does not exist on the host yet.
ReadWritePaths=/var/lib/dubplate/shadow

# The operator rule (HISTORY handoff item 5, spec:1387-1391): a
# hand-run shadow verb goes through `systemctl start
# dubplate-shadow.service` or `systemd-run` carrying this unit's own
# properties, never the bare binary as root. The read-only guarantee
# below is the unit's, not the binary's.
#
# OnFailure= above is wired and inert. No DUBPLATE_PING_SHADOW_URL is
# minted; the whole DUBPLATE_PING_* class is reserved for rung 9
# (internal/config/keys.go:116-125). An unset URL no-ops rather than
# erroring, which dubplate-serve.service:28-34 is the estate's
# precedent for. Stated precisely: the helper reads
# EnvironmentFile=/etc/dubplate/env at dubplate-ping-fail@.service:11,
# the incumbent's file, and execs the frozen /usr/local/bin/dubplate at
# :20, so a URL minted at rung 9 would have to land in the incumbent
# manifest and could never live in this greenfield unit's own
# EnvironmentFile. Plainly: no monitoring at rung 4. The stamp
# assertion at deploy and the journal check at the sitting are what
# catch a shadow that observes nothing.

# --- hardening, carried verbatim from dubplate-serve.service:99-125,
# minus AF_NETLINK (see below) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
AmbientCapabilities=
CapabilityBoundingSet=
UMask=0027
# Why AF_NETLINK is excluded: the serve unit's own comment (:116-124)
# records that netlink joined its set for a CPython subprocess whose
# glibc getaddrinfo opens a NETLINK_ROUTE socket, and "the Go process
# itself never needed it, since Go's own resolver has its own
# fallback." The shadow runs no subprocess, so the family stays
# denied.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
