[Unit]
Description=dubplate: the uploader, tus resumable uploads, journey polling, Access-enforced
# U12a (box task): this is the estate's one long-running, user-facing
# daemon, as opposed to every other dubplate-* unit's timer-driven
# oneshot. It is rsynced and daemon-reloaded by scripts/deploy.sh's
# UNIT_FILES step like the rest, but deliberately NOT enabled by that
# step's `systemctl enable --now $TIMER_UNITS` line -- it is started only
# in U12a's Geoff-sanctioned box step, once the Access application, the
# tunnel ingress PUT, and DUBPLATE_ACCESS_AUD all exist and can be
# verified end to end before real traffic reaches it.
#
# After=docker.service, not the oneshot units' network-online.target
# pairing: serve does not depend on outbound network reachability to
# start (U2's Access verifier fetches JWKS lazily, on first request, not
# at startup) -- it depends on the compose stack's bridge network
# existing, since U7's listener binds the bridge gateway IP
# (compose.yaml's pinned 172.30.0.1) alongside loopback. Boot resilience
# for binding an IP the host has not configured on any interface yet
# (docker.service ordered-before, not necessarily interface-up-before)
# comes from U7's freebindControl -- IP_FREEBIND set on the listening
# socket via net.ListenConfig.Control (internal/serve/serve.go) -- NOT
# from any unit directive: no such systemd directive as `IPFreeBind=`
# exists (N7, verified against internal/serve/serve_test.go's own
# "exact BindAddrs, IP_FREEBIND" test). Restart=/RestartSec= below are
# the documented backstop for the case IP_FREEBIND doesn't save --
# never the fix itself.
After=docker.service
# OnFailure matches the sibling units' own idiom exactly (see
# dubplate-disk-check.service, dubplate-import.service,
# dubplate-backup.service, dubplate-navidrome-check.service): a literal
# per-unit slug, resolved to DUBPLATE_PING_SERVE_URL by `dubplate
# ping-fail serve` -- unset today (no pings check named "serve" is
# minted yet), which no-ops cleanly rather than erroring
# (cmd/dubplate/pingfail.go), so wiring this ahead of that mint is safe.
OnFailure=dubplate-ping-fail@serve.service
# Conductor ruling, 2026-09-01, amending U12a's literal
# StartLimitIntervalSec=0 spec: interval 0 means systemd never gives up
# restarting and the unit NEVER enters "failed" -- which also means
# OnFailure= above never fires. A crash-looping user-facing surface
# would then alert nobody, silently serving 502s forever. 300s/30
# restarts gives Restart=on-failure + a 5s RestartSec generous room for
# real transient failures (a JWKS blip, a startup race right after
# boot) while still tripping -- and alerting -- on a genuine crash loop
# well before an hour has passed.
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=simple
User=music
EnvironmentFile=/etc/dubplate/env
ExecStart=/usr/local/bin/dubplate serve

Restart=on-failure
RestartSec=5

# 15s, not the oneshot units' default: long enough that a client
# mid-PATCH gets a real chance to finish, short enough that a stuck
# process still goes down before the next deploy's restart. A SIGKILL
# that lands anyway mid-PATCH is safe -- tus is resumable by design, so
# the client's next PATCH just continues from the last offset tusd
# actually flushed; this is not a data-loss risk to design around.
TimeoutStopSec=15

# ReadWritePaths=, derived by reading internal/serve's own writes (not
# guessed): NewServer opens ledger.Open(cfg.LedgerPath), whose default is
# <StateDir>/contributions.jsonl (internal/config.Load), so StateDir
# (/var/lib/musicbox, the same persistent directory dubplate-import.
# service and dubplate-backup.service already write to) is required.
# upload.go assembles every session under <UploadsDir>/<id>/
# (filestore.New(cfg.Paths.UploadsDir), the tus blob store itself, plus
# archive extraction and the session.json sidecar) and only ever
# os.Rename()s a completed session's directory into
# <InboxDir>/<dirname>/ (upload.go's promote) -- so both UploadsDir
# (/srv/music/uploads) and InboxDir (/srv/music/inbox) are required, and
# NewServer's own startup check (sameFilesystem) already refuses to start
# if they are not on one filesystem, which this repo's env values honor.
# writeNudgeTrigger (serve.go) writes one file per promoted session into
# <TriggerDir>/nudge-triggers -- U8's tmpfiles fragment creates this
# exact path (config/tmpfiles-dubplate.conf) and
# dubplate-import-nudge.service's own ReadWritePaths= grants the same
# literal, /run/dubplate/nudge-triggers, so this unit matches it exactly
# rather than the wider, un-tmpfiles'd /run/dubplate parent.
# No StagingDir, ReviewDir, or QuarantineDir: those are the importer's
# territory (dubplate-import.service, dubplate-import-nudge.service),
# never written by internal/serve.
ReadWritePaths=/var/lib/musicbox /srv/music/uploads /srv/music/inbox /run/dubplate/nudge-triggers

# --- hardening (U8's baseline plus the full U12a set; see U8's
# dubplate-import-nudge.service/dubplate-import.service for the sibling
# baseline this extends) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
AmbientCapabilities=
CapabilityBoundingSet=
UMask=0027
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
