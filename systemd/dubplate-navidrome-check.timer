[Unit]
Description=dubplate: run dubplate-navidrome-check every 5 minutes

[Timer]
# Mirrors musicbox-navidrome-check.timer's own schedule and jitter
# exactly: same job, same rationale (a shorter jitter window than the
# disk check's, proportional to this timer's own 5-minute interval).
OnCalendar=*:0/5
RandomizedDelaySec=60
Persistent=true
Unit=dubplate-navidrome-check.service

[Install]
WantedBy=timers.target
