[Unit]
Description=dubplate-server: the web surface, sign-in, and the boundary probe
# No network-online ordering: serve binds the addresses in
# DUBPLATE_SERVE_BIND_ADDRS, 127.0.0.1 when that key is unset, as it is in
# the shipped template, and reaches no outbound host at startup, so it has
# nothing to wait on from the network.
#
# A crash loop must end in "failed" rather than restart forever: 30
# restarts inside 300s leaves room for transient start failures and still
# stops a real crash loop.
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
# Type=exec reports a start failure when the binary cannot be invoked
# (systemd.service(5): "systemctl start command lines for exec services
# will report failure when the service's binary cannot be invoked
# successfully"), which Type=simple does not.
Type=exec
User=music
EnvironmentFile=/etc/dubplate/server.env
ExecStart=/usr/local/bin/dubplate-server serve

Restart=on-failure
RestartSec=5

# Serve drains in-flight requests for up to 25 seconds on stop, so the
# unit's own stop timeout sits above it as the backstop.
TimeoutStopSec=30

# Why the grant is two leaves and one volume directory: serve writes its sign-in state under
# auth.StoreDir (DUBPLATE_STATE_DIR plus /auth) and its member and settings
# store under the store leaf (DUBPLATE_STATE_DIR plus /store), and nothing
# else under the state directory. The third entry, /srv/music, is the music
# volume's directory, the common parent of DUBPLATE_STAGING_DIR and
# DUBPLATE_LIBRARY_ROOT. One entry rather than two because rename(2) fails
# with EXDEV across mount points, "even if the same filesystem is mounted
# on both" (man 2 rename), and two ReadWritePaths= entries can become two
# mount points in the unit's namespace; one entry over the parent keeps the
# staging-to-library rename inside one mount. Each entry carries no "-" or "+" prefix:
# systemd.exec(5) says a "-" prefixed path is ignored when it does not
# exist, which would turn a missing pre-create into EROFS at first write
# in place of the namespace failure at start. deploy.sh pre-creates both
# leaves, staging, and the library root before the unit ever starts; without them startup fails with
# "Failed to set up mount namespacing", systemd's own error for a
# ReadWritePaths= entry that does not exist on the host yet. scripts/
# check.sh gates the entries, the template's state directory, staging and
# library rows, and deploy.sh's pre-creates staying in agreement.
ReadWritePaths=/var/lib/dubplate/auth /var/lib/dubplate/store /srv/music

# --- hardening ---
# The process never gains privilege through setuid or file capabilities.
NoNewPrivileges=yes
# Private /tmp and /var/tmp, gone at stop.
PrivateTmp=yes
# The whole file system is read-only except the granted leaves above.
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Go does not map writable executable memory.
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
AmbientCapabilities=
CapabilityBoundingSet=
# Files serve creates are never world-readable.
UMask=0027
# AF_NETLINK stays denied: serve runs no subprocess, and Go's own resolver
# has its fallback where glibc's lookup would open a netlink socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
