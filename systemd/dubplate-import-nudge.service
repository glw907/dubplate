[Unit]
Description=dubplate: drain the nudge trigger directory, importing each triggered session
# Triggered by dubplate-import-nudge.path (DirectoryNotEmpty= on the
# trigger directory) and backstopped, independently, by
# dubplate-import.timer's own 15-minute poll -- both settle the same
# InboxDir/ledger, so this unit's OnFailure chain is the same one
# dubplate-import.service uses: one "import" check either way.
OnFailure=dubplate-ping-fail@import.service
After=network-online.target docker.service
Wants=network-online.target
# U8 (plan-time decision): `dubplate nudge-consume` owns retry timing
# itself -- lock.AcquireBlocking under a bounded context timeout, one
# lock acquisition for the whole batch of triggered sessions -- so
# systemd must never rate-limit or refuse a restart here. The path
# unit's own level-triggered re-arm and the 15-minute timer backstop
# are what actually bound how often this runs.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=music
EnvironmentFile=/etc/dubplate/env
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# No RuntimeDirectory=: the trigger directory is a tmpfiles.d fragment
# (config/tmpfiles-dubplate.conf), not a per-unit RuntimeDirectory --
# vps-conventions: RuntimeDirectory is not reference-counted across
# units, and dubplate-serve.service (the writer) and this unit (the
# reader) do not share a lifecycle.
#
# /run/dubplate/nudge-triggers matches config/tmpfiles-dubplate.conf's
# own path exactly (U8's plan-time decision: that fragment is the one
# place this literal is authored; deploy.sh's rendered
# DUBPLATE_RUN_DIR must agree with it). The rest mirrors
# dubplate-import.service's own grant exactly -- `dubplate
# nudge-consume` runs the same importer.Importer pipeline
# (internal/importer/importer.go) against the same paths, see that
# unit's own ReadWritePaths comment for the full derivation.
ReadWritePaths=/run/dubplate/nudge-triggers /srv/music /var/lib/musicbox
ExecStart=/usr/local/bin/dubplate nudge-consume
