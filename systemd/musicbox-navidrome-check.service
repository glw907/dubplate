[Unit]
Description=musicbox: HTTP heartbeat against Navidrome's /rest/ping
# See music-import.service's comment: the instance name is a healthchecks.io
# slug, matched against MUSICBOX_HC_NAVIDROME_URL in
# env/musicbox.env.template. Belt and suspenders alongside the script's own
# ping_hc fail calls: this catches an unhandled crash (a missing lib.sh, an
# unbound var) that exits before the script reaches either ping_hc branch
# itself.
OnFailure=musicbox-ping-failure@navidrome.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=music
EnvironmentFile=/etc/musicbox/env
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ExecStart=/usr/local/bin/musicbox-navidrome-check
