[Unit]
Description=musicbox: scan contributor inboxes and import new music
# The instance name ("import") is the healthchecks.io slug musicbox-ping-
# failure passes straight to ping_hc; it must match the MUSICBOX_HC_IMPORT_URL
# variable name in env/musicbox.env.template (uppercased, "-" -> "_").
OnFailure=musicbox-ping-failure@import.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=music
# Creates /run/musicbox every boot, owned by music:music. No longer holds
# the flock lock file (that moved to the persistent /var/lib/musicbox, see
# lib.sh's musicbox_lock_file); still holds the scan-trigger temp
# credential file, which stays on this tmpfs on purpose.
RuntimeDirectory=musicbox
EnvironmentFile=/etc/musicbox/env
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# /var/lib/musicbox holds the persistent import/beet flock lock file;
# deploy.sh pre-creates it (owned music:music) since ReadWritePaths
# requires the path to already exist on the host or the unit fails to
# start with "Failed to set up mount namespacing".
ReadWritePaths=/srv/music /run/musicbox /var/lib/musicbox
ExecStart=/usr/local/bin/music-import
