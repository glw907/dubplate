+// The two shapes the build's fallback document carries that tie it to
+// the site root: each asset reference opens a quoted, root-absolute
+// path, and the inline script sets the client router's base to the
+// empty root.
+var (
+	fallbackAssetRef = []byte(`"/_app/`)
+	fallbackBase     = []byte(`base: ""`)
+)
+
+// RebaseFallback returns raw, the build's fallback document, moved
+// under prefix: every quoted "/_app/ reference gains prefix ahead of
+// it, the router base "" becomes prefix, and the CSP meta's hash of
+// each script the move changed becomes the changed script's hash.
+//
+// Every prerendered document references its assets relative to its own
+// URL, but the fallback is written for no one URL: it answers whatever
+// unmatched path a request names, at any depth, so the build writes its
+// references root-absolute and its base empty, and neither resolves
+// under an owned prefix. prefix is a validated [Prefix], so it carries
+// no quote, backslash, or angle bracket that could leave the string or
+// attribute it lands in.
+//
+// A document with no root-absolute asset reference, or whose router
+// base is not "" exactly once, is refused, naming it: either is a
+// build shape this rewrite was not written for. So is a changed script
+// whose hash the meta does not list exactly once. The result still
+// passes through [DocumentCSP], which refuses any inline script the
+// rewritten meta does not hash.
+func RebaseFallback(name string, raw []byte, prefix Prefix) ([]byte, error) {
+	if !bytes.Contains(raw, fallbackAssetRef) {
+		return nil, fmt.Errorf("serve: document %q: no root-absolute asset reference to rebase", name)
+	}
+	if n := bytes.Count(raw, fallbackBase); n != 1 {
+		return nil, fmt.Errorf("serve: document %q: the router base %q appears %d times, want exactly 1", name, fallbackBase, n)
+	}
+	rebased := bytes.ReplaceAll(raw, fallbackAssetRef, []byte(`"`+prefix.value+`/_app/`))
+	rebased = bytes.Replace(rebased, fallbackBase, []byte(`base: "`+prefix.value+`"`), 1)
+
+	before, err := scriptBodies(raw)
+	if err != nil {
+		return nil, fmt.Errorf("serve: document %q: %w", name, err)
+	}
+	after, err := scriptBodies(rebased)
+	if err != nil {
+		return nil, fmt.Errorf("serve: document %q: %w", name, err)
+	}
+	for i, body := range before {
+		if bytes.Equal(body, after[i]) {
+			continue
+		}
+		old := []byte("'" + scriptHash(body) + "'")
+		if n := bytes.Count(rebased, old); n != 1 {
+			return nil, fmt.Errorf("serve: document %q: a rebased script's hash appears %d times, want exactly 1", name, n)
+		}
+		rebased = bytes.Replace(rebased, old, []byte("'"+scriptHash(after[i])+"'"), 1)
+	}
+	return rebased, nil
+}
