# Template for /etc/musicbox/env, rendered by scripts/deploy.sh from this
# file plus the sourced workstation age-store values (~/.local/secrets).
# Every NAME below must resolve to a non-empty value at render time or
# deploy.sh fails, listing what is missing, rather than writing a box-side
# env file with a silently blank secret.
#
# This file itself carries no real values — it is committed to the repo as
# the list of names deploy.sh renders. See docs/STATUS.md for which of these
# are still pending Task 0, and the workstation secrets registry
# (~/.dotfiles/secrets/registry.md) for scope and rotation.

# R2 (read-write, scoped to bucket music-library): music-backup's rclone syncs.
MUSICBOX_R2_ACCESS_KEY_ID=
MUSICBOX_R2_SECRET_ACCESS_KEY=

# Cloudflare Tunnel token for the named tunnel "musicbox" (Task 5). Consumed
# by compose.yaml's cloudflared service as TUNNEL_TOKEN.
MUSICBOX_TUNNEL_TOKEN=

# Navidrome's password-encryption passphrase (ND_PASSWORDENCRYPTIONKEY is
# the literal env var Navidrome itself reads; compose.yaml passes this
# value straight through).
ND_PASSWORDENCRYPTIONKEY=

# Spotify developer app credentials for Navidrome's Spotify agent (artist
# images in the UI). Literal env var names Navidrome reads; compose.yaml
# passes both straight through, like the passphrase above. Minted from the
# app at developer.spotify.com/dashboard; rotation is a dashboard
# regenerate + secret-set.sh + deploy.
ND_SPOTIFY_ID=
ND_SPOTIFY_SECRET=

# Fastmail SMTP app password for geoff-login@907.life, used by
# config/msmtprc's passwordeval (see that file's comment for why msmtp
# reads this from its own environment rather than the file directly).
MUSICBOX_SMTP_PASSWORD=

# healthchecks.io ping URLs, one per check (Task 6 creates all four via the
# API). musicbox-ping-failure and scripts/music-import|music-backup|
# musicbox-disk-check|musicbox-navidrome-check resolve these by uppercasing
# the slug they're given and prefixing MUSICBOX_HC_ / suffixing _URL (see
# lib.sh's ping_hc) — all four are wired to real ping calls.
MUSICBOX_HC_IMPORT_URL=
MUSICBOX_HC_BACKUP_URL=
MUSICBOX_HC_DISK_URL=
MUSICBOX_HC_NAVIDROME_URL=

# Navidrome admin credentials, used only by music-import's
# trigger_navidrome_scan() to obtain a scan-trigger JWT (native admin API,
# not Subsonic — see docs/HISTORY.md's Task 2 entry). Not consumed by
# compose.yaml itself.
NAVIDROME_ADMIN_USER=
NAVIDROME_ADMIN_PASSWORD=

# FileBrowser Quantum's admin bootstrap password (the literal env var it reads,
# equivalent to auth.methods.password.adminPassword; the username is fixed as
# "admin"). Without it the first-run default admin fails our own
# auth.methods.password.minLength: 8 policy in config/filebrowser.yaml and the
# container crash-loops. Task 8 replaces this with per-contributor accounts and
# rotates the password out of band.
FILEBROWSER_ADMIN_PASSWORD=

# --- dubplate rewrite: additive DUBPLATE_* names (T12; window closes T13) --
# internal/config.Load requires every name below, non-empty, no defaults
# (Site-identifying config fields carry no default -- only behavior
# thresholds do, and those aren't in this file). Both this block and the
# MUSICBOX_*/ND_* names above stay live at once: the shell layer above
# still resolves MUSICBOX_HC_* itself, and T12 flips only the check and
# backup jobs to dubplate, so both generations must find their own names
# in the same env file until T13 deletes the shell layer and this comment.
# Every ALIAS line below carries the SAME secret value as its named
# MUSICBOX_*/ND_* counterpart above under a new name (dubplate reads its
# own env-var names only, per internal/config's portability-wall doctrine
# -- it never falls back to the old name); every NEW line is a value that
# had no env-var name before T12, minted fresh into the age store.

# Admin contact (NEW): dubplate-import's own notify path (T13). The shell
# layer's equivalent was music-import's GEOFF_EMAIL script default, never
# an env var.
DUBPLATE_ADMIN_EMAIL=

# SMTP (config/msmtprc's literal values, never previously env vars except
# the password). HOST/PORT/USER/FROM are NEW. PASSWORD is canonical here:
# DUBPLATE_SMTP_PASSWORD is the name secret-set.sh mints against, and
# MUSICBOX_SMTP_PASSWORD above is the same-value alias the still-live shell
# layer consumes, retiring at T13.
DUBPLATE_SMTP_HOST=
DUBPLATE_SMTP_PORT=
DUBPLATE_SMTP_USER=
DUBPLATE_SMTP_PASSWORD=
DUBPLATE_SMTP_FROM=

# R2 (scripts/music-backup's hardcoded ACCOUNT_ID/BUCKET/REMOTE, now
# required config instead of script constants: NEW). ACCESS_KEY_ID and
# SECRET_ACCESS_KEY are ALIASes of MUSICBOX_R2_ACCESS_KEY_ID and
# MUSICBOX_R2_SECRET_ACCESS_KEY.
DUBPLATE_R2_ACCOUNT_ID=
DUBPLATE_R2_BUCKET=
DUBPLATE_R2_REMOTE=
DUBPLATE_R2_ACCESS_KEY_ID=
DUBPLATE_R2_SECRET_ACCESS_KEY=

# Navidrome (URL is NEW -- scripts/musicbox-navidrome-check's hardcoded
# localhost:4533 default, now required config). ADMIN_USER/ADMIN_PASSWORD
# are ALIASes of NAVIDROME_ADMIN_USER/NAVIDROME_ADMIN_PASSWORD above.
DUBPLATE_NAVIDROME_URL=
DUBPLATE_NAVIDROME_ADMIN_USER=
DUBPLATE_NAVIDROME_ADMIN_PASSWORD=

# Fixed config paths (all NEW -- config/ and beets install locations
# deploy.sh already places these at, now named for dubplate to read
# rather than left as script-internal constants).
DUBPLATE_CONTRIBUTORS_FILE=
DUBPLATE_REJECT_EMAIL_TEMPLATE=
DUBPLATE_BEETS_CONFIG=
DUBPLATE_BEETS_DB=
DUBPLATE_NAVIDROME_DB=

# Working directories (all NEW). DUBPLATE_STATE_DIR is deliberately
# /var/lib/musicbox, not the shell layer's /srv/music/state: dubplate
# unifies its lock files, run report, and per-run tag log in the one
# persistent, non-RuntimeDirectory location the architecture refinement
# pass's doctrine requires for locks (deploy.sh's /var/lib/musicbox
# pre-create comment carries the rest). DUBPLATE_BACKUP_STAGING keeps the
# shell layer's own path, on the /srv/music volume rather than
# /var/lib/musicbox, since a large library's DB snapshots belong beside
# the library's own disk budget, not the root filesystem's.
DUBPLATE_LIBRARY_DIR=
DUBPLATE_INBOX_DIR=
DUBPLATE_STAGING_DIR=
DUBPLATE_STATE_DIR=
DUBPLATE_RUN_DIR=
DUBPLATE_REVIEW_DIR=
DUBPLATE_QUARANTINE_DIR=
DUBPLATE_BACKUP_STAGING=

# Ping URLs for the two jobs T12 flips (ALIASes of MUSICBOX_HC_BACKUP_URL
# and MUSICBOX_HC_DISK_URL/MUSICBOX_HC_NAVIDROME_URL above): dubplate
# resolves its own success/fail pings through DUBPLATE_PING_<SLUG>_URL
# (internal/config's pingURLsFromEnv), never the MUSICBOX_HC_ names --
# that scan is what internal/backup and internal/checks report their own
# results through; the OnFailure=musicbox-ping-failure@<slug> chain on
# each dubplate-* unit is a separate, redundant backstop that still reads
# the MUSICBOX_HC_ names via the unflipped shell script. Not required by
# config.Load (an unset ping URL is a valid no-Worker no-op), but needed
# here for monitoring continuity once the shell units disable.
# DUBPLATE_PING_IMPORT_URL is deliberately absent: import's ping-fail
# flip is T13's.
DUBPLATE_PING_BACKUP_URL=
DUBPLATE_PING_DISK_URL=
DUBPLATE_PING_NAVIDROME_URL=

