# Template for /etc/dubplate/env, rendered by scripts/deploy.sh from this
# file plus the sourced workstation age-store values (~/.local/secrets).
# Every NAME below must resolve to a non-empty value at render time or
# deploy.sh fails, listing what is missing, rather than writing a box-side
# env file with a silently blank secret.
#
# This file itself carries no real values — it is committed to the repo as
# the list of names deploy.sh renders. See docs/STATUS.md for estate state,
# and the workstation secrets registry (~/.dotfiles/secrets/registry.md) for
# scope and rotation.
#
# internal/config.Load requires every DUBPLATE_* name below except the
# DUBPLATE_PING_* block, non-empty, no defaults (site-identifying config
# fields carry no default -- only behavior thresholds do, and those aren't
# in this file). The shell layer, its MUSICBOX_*/NAVIDROME_ADMIN_*/
# MUSICBOX_HC_* env-var names, and the additive rename window they lived in
# are gone (rewrite plan T13): dubplate reads its own env-var names only,
# per internal/config's portability-wall doctrine.

# Admin contact: dubplate-import's own notify path.
DUBPLATE_ADMIN_EMAIL=

# SMTP (config/msmtprc's former literal values; msmtp itself retired at
# T13, notify parity having passed against internal/notify).
DUBPLATE_SMTP_HOST=
DUBPLATE_SMTP_PORT=
DUBPLATE_SMTP_USER=
DUBPLATE_SMTP_PASSWORD=
DUBPLATE_SMTP_FROM=

# R2 (read-write, scoped to bucket music-library): internal/backup's rclone
# syncs and internal/restore's rclone pulls.
DUBPLATE_R2_ACCOUNT_ID=
DUBPLATE_R2_BUCKET=
DUBPLATE_R2_REMOTE=
DUBPLATE_R2_ACCESS_KEY_ID=
DUBPLATE_R2_SECRET_ACCESS_KEY=

# Navidrome. URL backs internal/checks' HTTP heartbeat; ADMIN_USER/
# ADMIN_PASSWORD back internal/beets.TriggerScan's native admin API call
# (not Subsonic — see docs/HISTORY.md's Task 2 entry). Not consumed by
# compose.yaml itself.
DUBPLATE_NAVIDROME_URL=
DUBPLATE_NAVIDROME_ADMIN_USER=
DUBPLATE_NAVIDROME_ADMIN_PASSWORD=

# Fixed config paths: config/ and beets install locations deploy.sh places
# these at.
DUBPLATE_CONTRIBUTORS_FILE=
DUBPLATE_REJECT_EMAIL_TEMPLATE=
DUBPLATE_BEETS_CONFIG=
DUBPLATE_BEETS_DB=
DUBPLATE_NAVIDROME_DB=

# Working directories. DUBPLATE_STATE_DIR is deliberately /var/lib/musicbox,
# not a path under /srv/music/state: dubplate unifies its lock files, run
# report, and per-run tag log in the one persistent, non-RuntimeDirectory
# location the architecture refinement pass's doctrine requires for locks
# (deploy.sh's /var/lib/musicbox pre-create comment carries the rest). Box
# data paths (/srv/music, /var/lib/musicbox) keep their existing names —
# only the estate's config/identity layer (/etc, /opt) renamed at T13; the
# data-path rename, if ever wanted, is a live-box migration out of this
# change's scope. DUBPLATE_BACKUP_STAGING keeps the shell layer's own path,
# on the /srv/music volume rather than /var/lib/musicbox, since a large
# library's DB snapshots belong beside the library's own disk budget, not
# the root filesystem's.
DUBPLATE_LIBRARY_DIR=
DUBPLATE_INBOX_DIR=
DUBPLATE_STAGING_DIR=
DUBPLATE_STATE_DIR=
DUBPLATE_RUN_DIR=
DUBPLATE_REVIEW_DIR=
DUBPLATE_QUARANTINE_DIR=
DUBPLATE_BACKUP_STAGING=

# Ping URLs, one per check (healthchecks.io or any provider ping.Client can
# GET/POST). Not required by config.Load (an unset ping URL is a valid
# no-Worker no-op — dubplate ping-fail no-ops the same way from the
# OnFailure= chain), but needed for monitoring continuity: each dubplate-*
# unit's own success/fail ping AND its OnFailure=dubplate-ping-fail@<slug>
# backstop both resolve through DUBPLATE_PING_<SLUG>_URL.
DUBPLATE_PING_IMPORT_URL=
DUBPLATE_PING_BACKUP_URL=
DUBPLATE_PING_DISK_URL=
DUBPLATE_PING_NAVIDROME_URL=

# --- literal env-var names compose.yaml and third-party containers read directly ---
# These are not DUBPLATE_*-prefixed because compose.yaml and the containers
# it runs (Navidrome, FileBrowser, cloudflared) read these exact names;
# renaming them would require patching those images' own config surface for
# no benefit.

# Navidrome's password-encryption passphrase (ND_PASSWORDENCRYPTIONKEY is
# the literal env var Navidrome itself reads; compose.yaml passes this
# value straight through).
ND_PASSWORDENCRYPTIONKEY=

# Spotify developer app credentials for Navidrome's Spotify agent (artist
# images in the UI). Literal env var names Navidrome reads; compose.yaml
# passes both straight through, like the passphrase above. Minted from the
# app at developer.spotify.com/dashboard; rotation is a dashboard
# regenerate + secret-set.sh + deploy.
ND_SPOTIFY_ID=
ND_SPOTIFY_SECRET=

# FileBrowser Quantum's admin bootstrap password (the literal env var it
# reads, equivalent to auth.methods.password.adminPassword; the username is
# fixed as "admin"). Without it the first-run default admin fails our own
# auth.methods.password.minLength: 8 policy in config/filebrowser.yaml and
# the container crash-loops. Task 8 replaces this with per-contributor
# accounts and rotates the password out of band.
FILEBROWSER_ADMIN_PASSWORD=

# Cloudflare Tunnel token for the named tunnel "musicbox" (the tunnel
# itself is a live Cloudflare resource, not renamed by this change).
# Renamed from MUSICBOX_TUNNEL_TOKEN at T13 to match the DUBPLATE_* naming
# convention; same secret value, new variable name. Consumed by
# compose.yaml's cloudflared service as TUNNEL_TOKEN.
DUBPLATE_TUNNEL_TOKEN=
